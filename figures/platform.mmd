flowchart TD
    in([Подача]) --> R1["R1 · Приём"]
    R1 -->|Класс Б| R3["R3 · Ручная модерация"]
    R1 --> R2["R2 · AI-модерация"]
    R2 -->|Подозрение| R3
    R2 -->|Допуск| R5a["R5 · Публикация"]
    R3 -->|Допуск| R5a
    R3 -->|Отрицательное решение| rej([Отклонение или апелляция])
    rej -.-> R6["R6 · Поддержка"]
    R6 -.->|Повтор проверки| R3
    R5a --> live["Активная кампания"]
    live -->|Отдельные пожертвования| R4["R4 · Платёжный шлюз"]
    R4 -->|Успех| R5b["R5 · Учёт"]
    R4 -.->|Ошибка| R6
    R5b -.->|Переполнение| R6
    R6 -.->|Повтор платежа| R4
    R5b --> check{"Сворачивание и расчёт"}
    live -->|Срок истёк| check
    check -->|Цель достигнута| R8["R8 · Выплата"]
    check -->|При наличии спора| R7["R7 · Арбитраж"]
    R7 -->|Разрешён| R8
    R7 -->|Блокировка| refund([Завершение и возврат])
    check -->|Цель не достигнута| refund
    R8 --> paid([Успешная выплата])
