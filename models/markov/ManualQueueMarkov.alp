        <AdditionalClassCode>final double lambda = 1.3892129641587645;
final double mu = 2.0 / 3;
void optimizeCapacity() {
    StringBuilder data = new StringBuilder("channels,cost,blocking\n");
    double best = Double.POSITIVE_INFINITY;
    int chosen = 0;
    for (int c = 1; c &lt;= 3; c++) {
        double weight = 1, mass = 1;
        for (int n = 1; n &lt;= c+24; n++) {
            weight *= lambda/(Math.min(n,c)*mu);
            mass += weight;
        }
        double blocked = weight/mass;
        if (blocked &lt; best) { best = blocked; chosen = c; }
        data.append(c).append(',').append(5*c).append(',').append(blocked).append('\n');
    }
    traceln("Выбрано каналов: " + chosen + ", блокировка: " + best);
    try {
        java.nio.file.Files.writeString(java.nio.file.Path.of(System.getProperty("java.io.tmpdir"),
            "crowdfunding-markov-optimization.csv"),data.toString());
    } catch (java.io.IOException e) { throw new RuntimeException(e); }
}


void audit() { optimizeCapacity();
    String value = "time=" + time() + " sum=" + (p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19 + p20 + p21 + p22 + p23 + p24 + p25 + p26) + " p0=" + p0 + " p26=" + p26;
    traceln("Контроль вероятностей " + value);
    try {
        java.nio.file.Files.writeString(java.nio.file.Path.of(System.getProperty("java.io.tmpdir"),
            "crowdfunding-markov.txt"), value);
    } catch (java.io.IOException e) {
        throw new RuntimeException(e);
    }
}

int sampleIndex;
ShapePolyLine[] paths;
final StringBuilder runSeries = new StringBuilder("hour,model,p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11,p12,p13,p14,p15,p16,p17,p18,p19,p20,p21,p22,p23,p24,p25,p26\n");
void record(boolean scheduleNext) {
    if (paths == null) {
        paths = new ShapePolyLine[] {curve0,curve1,curve2,curve3,curve4,curve5,curve6,curve7,curve8,curve9,curve10,curve11,curve12,curve13,curve14,curve15,curve16,curve17,curve18,curve19,curve20,curve21,curve22,curve23,curve24,curve25,curve26};
        ShapeText[] rightTicks = {right0,right1,right2};
        for (ShapeText tick : rightTicks)
            tick.setText(String.format(java.util.Locale.ROOT,"%.2f",getEngine().getStopTime()));
    }
    double[] plotted = {p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11,p12,p13,p14,p15,p16,p17,p18,p19,p20,p21,p22,p23,p24,p25,p26};
    double[] maxY = {1,1,1,1,1,1,1,1,1,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16};
    double horizon = getEngine().getStopTime();
    double x = 710 * time() / horizon;
    for (int i = 0; i &lt; paths.length; i++) {
        double y = -140 * Math.min(1, Math.max(0, plotted[i]/maxY[i]));
        ShapePolyLine curve = paths[i];
        curve.setNPoints(Math.max(2, sampleIndex + 1));
        curve.setPoint(sampleIndex,x,y);
        if (sampleIndex == 0) curve.setPoint(1,x,y);
    }
    sampleIndex++;
    currentTime.setText(String.format(java.util.Locale.ROOT,"Модельное время: %.2f / %.2f ч",time(),horizon));
    double[] current = {p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11,p12,p13,p14,p15,p16,p17,p18,p19,p20,p21,p22,p23,p24,p25,p26};
    runSeries.append(time()).append(',').append("markov");
    for (double value : current) runSeries.append(',').append(value);
    runSeries.append('\n');
    if (scheduleNext) {
        if (time()+1 &lt; horizon-.00002) create_Track(1);
    } else {
        try {
            java.nio.file.Files.writeString(java.nio.file.Path.of(System.getProperty("java.io.tmpdir"),
                "crowdfunding-series-manualqueuemarkov-" + "markov" + ".csv"),runSeries.toString());
        } catch (java.io.IOException e) { throw new RuntimeException(e); }
    }
}
</AdditionalClassCode>
        <StartupCode>create_Audit(4); create_Track(0.000001); create_FinalSample(getEngine().getStopTime() - .00001);</StartupCode>
